{
  "name": "tandem-app",
  "version": "0.1.0",
  "private": true,
  "description": "Tandem's window: the Electron shell over the Rust core's rpc stream.",
  "author": "Gianni Acquisto",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "binary": "cargo build -p tandem --manifest-path ../rust/Cargo.toml",
    "binary:release": "node scripts/prepare-binary.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "smoke": "node scripts/smoke-packaged.mjs",
    "pack": "npm run build && npm run binary:release && electron-builder --dir",
    "dist": "npm run build && npm run binary:release && electron-builder --publish never"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
