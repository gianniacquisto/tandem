.DS_Store
.build/
.swiftpm/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# Fixture homes are scratch state: created on demand, never committed.
# The port's home is the one exception: it is content both implementations read.
/Fixtures/*
!/Fixtures/README.md
!/Fixtures/port/
# The CLI's goldens are the contract both implementations answer to (PRT-8).
!/Fixtures/goldens/
