      "argv": ["ticket", "move", "--id", "CYC-1"]
    },
    {
      "group": "ticket",
      "case": "block",
      "setup": [
        {"argv": ["lane", "add", "--name", "Cycle", "--abbr", "CYC"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Cycle"]},
        {"argv": ["ticket", "add", "--title", "Second ticket", "--lane", "Cycle"]}
      ],
      "argv": ["ticket", "block", "--id", "CYC-1", "--on", "CYC-2"]
    },
    {
      "group": "ticket",
      "case": "block-self",
      "setup": [
        {"argv": ["lane", "add", "--name", "Cycle", "--abbr", "CYC"]},
