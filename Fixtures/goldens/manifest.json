        {"argv": ["ticket", "comment", "add", "--id", "TAN-1", "--author", "golden-agent", "--body", "A comment the golden keeps."]}
      ],
      "argv": ["ticket", "comment", "list", "--id", "TAN-1"]
    },
    {
      "group": "ticket",
      "case": "list-help",
      "argv": ["ticket", "list", "--help"]
    },
