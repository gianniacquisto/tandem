    },
    {
      "group": "ticket",
      "case": "comment-add-stdin",
      "stdin": "A comment from stdin.\n",
      "setup": [
        {"argv": ["lane", "add", "--name", "Tandem", "--abbr", "TAN"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Tandem"]}
      ],
      "argv": ["ticket", "comment", "add", "--id", "TAN-1", "--body", "-"]
    },
    {
      "group": "ticket",
      "case": "comment-list",
