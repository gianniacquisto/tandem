{
  "version": 1,
  "about": "The CLI's contract, captured from the Swift binary. One case per verb shape the suite exercises; a new shape is a deliberate line here, and `Scripts/capture-goldens.sh` writes Fixtures/goldens/<group>/<case>.json from it. Both implementations read this file: the capture runs the Swift binary, `rust/cli/tests/goldens.rs` runs the Rust one.",
  "home": "Fixtures/port/Home",
  "face": "Fixtures/port/agent-face",
  "env": {
    "OPENCODE_SESSION_ID": "golden-session",
    "TANDEM_AGENT": "golden-agent",
    "TANDEM_AGENT_BUNDLE": "$face"
  },
  "normalize": [
    {
      "kind": "prefix",
      "value": "$TANDEM_HOME",
      "as": "<tandem-home>"
    },
    {
      "kind": "prefix",
      "value": "$HOME",
      "as": "<home>"
    },
    {
      "kind": "schema",
      "as": "<schema>"
    },
    {
      "kind": "uuid",
      "as": "<id>"
    },
    {
      "kind": "timestamp",
      "as": "<timestamp>"
    }
  ],
  "cases": [
    {
      "group": "cli",
      "case": "help",
      "argv": ["--help"]
    },
    {
      "group": "cli",
      "case": "help-short",
      "argv": ["-h"]
    },
    {
      "group": "cli",
      "case": "no-arguments",
      "argv": [],
      "exit": 2
    },
    {
      "group": "cli",
      "case": "unknown-verb",
      "argv": ["frobnicate"],
      "exit": 2
    },
    {
      "group": "cli",
      "case": "unknown-flag",
      "argv": ["ticket", "list", "--frobnicate"],
      "exit": 2
    },

    {
      "group": "ticket",
      "case": "help",
      "argv": ["ticket", "--help"]
    },
    {
      "group": "ticket",
      "case": "list-empty",
      "argv": ["ticket", "list"]
    },
    {
      "group": "ticket",
      "case": "list",
      "setup": [
        {"argv": ["lane", "add", "--name", "Cycle", "--abbr", "CYC"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Cycle"]},
        {"argv": ["ticket", "add", "--title", "Second ticket", "--lane", "Cycle"]}
      ],
      "argv": ["ticket", "list"]
    },
    {
      "group": "ticket",
      "case": "list-all",
      "setup": [
        {"argv": ["lane", "add", "--name", "Cycle", "--abbr", "CYC"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Cycle"]},
        {"argv": ["ticket", "add", "--title", "Second ticket", "--lane", "Cycle"]},
        {"argv": ["ticket", "complete", "--id", "CYC-1"]}
      ],
      "argv": ["ticket", "list", "--filter", "all"]
    },
    {
      "group": "ticket",
      "case": "list-lane",
      "setup": [
        {"argv": ["lane", "add", "--name", "Cycle", "--abbr", "CYC"]},
        {"argv": ["lane", "add", "--name", "Port", "--abbr", "PRT"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Cycle"]},
        {"argv": ["ticket", "add", "--title", "Port ticket", "--lane", "Port"]}
      ],
      "argv": ["ticket", "list", "--lane", "Cycle"]
    },
    {
      "group": "ticket",
      "case": "list-status",
      "setup": [
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--status", "ready"]},
        {"argv": ["ticket", "add", "--title", "Second ticket"]}
      ],
      "argv": ["ticket", "list", "--status", "ready"]
    },
    {
      "group": "ticket",
      "case": "list-assignee-self",
      "setup": [
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--assignee", "self"]},
        {"argv": ["ticket", "add", "--title", "Second ticket", "--assignee", "someone"]}
      ],
      "argv": ["ticket", "list", "--assignee", "self"]
    },
    {
      "group": "ticket",
      "case": "list-text",
      "setup": [
        {"argv": ["lane", "add", "--name", "Tandem", "--abbr", "TAN"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Tandem"]},
        {"argv": ["ticket", "add", "--title", "Second ticket"]}
      ],
      "argv": ["ticket", "list", "--text", "Second"]
    },
    {
      "group": "ticket",
      "case": "list-archived",
      "setup": [
        {"argv": ["lane", "add", "--name", "Tandem", "--abbr", "TAN"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Tandem"]},
        {"argv": ["ticket", "complete", "--id", "TAN-1"]},
        {"argv": ["ticket", "archive"]}
      ],
      "argv": ["ticket", "list", "--filter", "all", "--archived"]
    },
    {
      "group": "ticket",
      "case": "list-blocked",
      "setup": [
        {"argv": ["lane", "add", "--name", "Cycle", "--abbr", "CYC"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Cycle"]},
        {"argv": ["ticket", "add", "--title", "Second ticket", "--lane", "Cycle"]},
        {"argv": ["ticket", "block", "--id", "CYC-1", "--on", "CYC-2"]}
      ],
      "argv": ["ticket", "list", "--blocked"]
    },
    {
      "group": "ticket",
      "case": "show",
      "setup": [
        {"argv": ["lane", "add", "--name", "Cycle", "--abbr", "CYC"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Cycle", "--description", "A body the golden keeps."]}
      ],
      "argv": ["ticket", "show", "--id", "CYC-1"]
    },
    {
      "group": "ticket",
      "case": "show-unknown-ref",
      "argv": ["ticket", "show", "--id", "CYC-9"],
      "exit": 1
    },
    {
      "group": "ticket",
      "case": "add",
      "argv": ["ticket", "add", "--title", "Golden ticket"]
    },
    {
      "group": "ticket",
      "case": "add-flags",
      "setup": [
        {"argv": ["lane", "add", "--name", "Cycle", "--abbr", "CYC"]}
      ],
      "argv": ["ticket", "add", "--title", "Golden ticket", "--status", "ready",
               "--assignee", "self", "--lane", "Cycle", "--origin", "self",
               "--description", "A body the golden keeps."]
    },
    {
      "group": "ticket",
      "case": "add-description-stdin",
      "stdin": "A body from stdin.\n",
      "argv": ["ticket", "add", "--title", "Stdin ticket", "--description", "-"]
    },
    {
      "group": "ticket",
      "case": "add-missing-title",
      "argv": ["ticket", "add"],
      "exit": 1
    },
    {
      "group": "ticket",
      "case": "add-bad-status",
      "argv": ["ticket", "add", "--title", "Golden ticket", "--status", "nope"],
      "exit": 1
    },
    {
      "group": "ticket",
      "case": "set",
      "setup": [
        {"argv": ["lane", "add", "--name", "Cycle", "--abbr", "CYC"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Cycle"]}
      ],
      "argv": ["ticket", "set", "--id", "CYC-1", "--title", "Renamed ticket",
               "--status", "in-progress", "--assignee", "self"]
    },
    {
      "group": "ticket",
      "case": "set-description",
      "setup": [
        {"argv": ["lane", "add", "--name", "Tandem", "--abbr", "TAN"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Tandem", "--description", "An old body."]}
      ],
      "argv": ["ticket", "set", "--id", "TAN-1", "--description", "A replaced body."]
    },
    {
      "group": "ticket",
      "case": "set-description-stdin",
      "stdin": "A body from stdin.\n",
      "setup": [
        {"argv": ["lane", "add", "--name", "Tandem", "--abbr", "TAN"]},
        {"argv": ["ticket", "add", "--title", "Fixture ticket", "--lane", "Tandem", "--description", "An old body."]}
      ],
      "argv": ["ticket", "set", "--id", "TAN-1", "--description", "-"]
    },
    {
      "group": "ticket",
      "case": "move",
      "setup": [
