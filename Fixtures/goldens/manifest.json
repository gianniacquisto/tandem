      "group": "ticket",
      "case": "show-help",
      "argv": ["ticket", "show", "--help"]
    },
    {
      "group": "ticket",
      "case": "add-help",
      "argv": ["ticket", "add", "--help"]
    },
    {
      "group": "ticket",
      "case": "set-help",
      "argv": ["ticket", "set", "--help"]
    },
    {
      "group": "ticket",
      "case": "move-help",
      "argv": ["ticket", "move", "--help"]
    },
    {
      "group": "ticket",
      "case": "block-help",
      "argv": ["ticket", "block", "--help"]
    },
    {
      "group": "ticket",
      "case": "unblock-help",
      "argv": ["ticket", "unblock", "--help"]
    },
    {
      "group": "ticket",
      "case": "complete-help",
      "argv": ["ticket", "complete", "--help"]
    },
    {
