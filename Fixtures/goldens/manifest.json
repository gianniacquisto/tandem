{
  "version": 1,
  "about": "The CLI's contract, captured from the Swift binary before the cutover. One case per verb shape the suite exercises; a new shape is a deliberate line here and a hand-written Fixtures/goldens/<group>/<case>.json in the same shape. The Swift capture retired with the tree; `rust/cli/tests/goldens.rs` replays the frozen files.",
  "home": "Fixtures/port/Home",
  "face": "Fixtures/port/agent-face",
  "env": {
    "OPENCODE_SESSION_ID": "golden-session",
    "TANDEM_AGENT": "golden-agent",
    "TANDEM_AGENT_BUNDLE": "$face"
  },
  "normalize": [
    {
      "kind": "prefix",
      "value": "$TANDEM_HOME",
      "as": "<tandem-home>"
    },
    {
      "kind": "prefix",
      "value": "$HOME",
      "as": "<home>"
    },
    {
      "kind": "schema",
      "as": "<schema>"
    },
    {
      "kind": "backup-age",
      "as": "<age>"
    },
    {
      "kind": "uuid",
      "as": "<id>"
    },
    {
      "kind": "timestamp",
      "as": "<timestamp>"
    },
    {
      "kind": "answer-day",
      "as": "<day>"
    }
  ],
  "cases": [
    {
      "group": "cli",
      "case": "help",
      "argv": [
        "--help"
      ]
    },
    {
      "group": "cli",
      "case": "help-short",
      "argv": [
        "-h"
      ]
    },
    {
      "group": "cli",
      "case": "no-arguments",
      "argv": [],
      "exit": 2
    },
    {
      "group": "cli",
      "case": "unknown-verb",
